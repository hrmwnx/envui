# Application Configuration
APP_NAME=MyAwesomeApp
APP_ENV=local
APP_KEY=base64:randomGeneratedKeyStringExample12345=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=root
DB_PASSWORD=your_database_password

# Server Port Configuration
PORT=3000

# Email / SMTP Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Third-Party API Keys (Example Secrets)
STRIPE_KEY=pk_test_YourStripePublicKeyHere
STRIPE_SECRET=sk_test_YourStripeSecretKeyHere
